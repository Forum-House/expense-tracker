# ==============================================================================
# Yadav & Jain Company - Monthly Personal Finance Tracker Configuration
# ==============================================================================

# Database Engine:
# 'auto'   -> Automatically tries MySQL. If not reachable, seamlessly falls back to 
#             Portable SQLite stored on the pendrive (data/finance_tracker.db).
# 'sqlite' -> Force Portable SQLite (ideal for pendrive / zero-server use).
# 'mysql'  -> Force MySQL Database Server.
DB_ENGINE=auto

# MySQL Configuration (used if DB_ENGINE=mysql or when MySQL is running locally)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=shru
DB_NAME=MyPersonalTracker

# Web Server Configuration
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1
